#!/bin/bash
# focus - block distracting sites via /etc/hosts until a deadline.
#         Works on macOS and Linux.
#
# Usage:
#   sudo focus start [hours]   # start a block (default 3h); hours must be a whole number > 0
#   sudo focus add [hours]     # push the current deadline back by hours (default 3)
#   sudo focus stop            # stop everything now
#        focus status          # show whether a block is active and time left
#
# The deadline (unix epoch) is stored inline in the hosts marker, so add/status
# read it back. Edit the DOMAINS list below to change which sites are blocked.
set -euo pipefail

HOSTS=/etc/hosts
MARK_BEGIN="# focus-block BEGIN"   # full line is "<MARK_BEGIN> until=<epoch>"
MARK_END="# focus-block END"
OS=$(uname)

DOMAINS=(
  instagram.com www.instagram.com
  reddit.com www.reddit.com old.reddit.com i.redd.it
  linkedin.com www.linkedin.com
  x.com www.x.com twitter.com www.twitter.com
  facebook.com www.facebook.com m.facebook.com
  tiktok.com www.tiktok.com
)

flush_dns() {
  if [[ "$OS" == "Darwin" ]]; then
    dscacheutil -flushcache 2>/dev/null || true
    killall -HUP mDNSResponder 2>/dev/null || true
  else
    systemctl is-active --quiet systemd-resolved 2>/dev/null && resolvectl flush-caches 2>/dev/null || true
    systemctl is-active --quiet nscd 2>/dev/null && nscd -i hosts 2>/dev/null || true
  fi
}

# In-place sed without a backup file (macOS requires '' as the backup suffix).
sedi() {
  if [[ "$OS" == "Darwin" ]]; then
    sed -i '' "$@"
  else
    sed -i "$@"
  fi
}

# Format an epoch timestamp as "H:MM AM/PM".
fmt_epoch() {
  if [[ "$OS" == "Darwin" ]]; then
    date -r "$1" '+%l:%M %p' | sed 's/^ *//'
  else
    date -d "@$1" '+%l:%M %p' | sed 's/^ *//'
  fi
}

# Delete the marker block. Matches the BEGIN line by prefix so the trailing
# "until=<epoch>" is included in the range.
strip_block() {
  sedi "/^${MARK_BEGIN}/,/^${MARK_END}\$/d" "$HOSTS"
}

# Echo the stored deadline epoch, or nothing if no block is active.
# The trailing "|| true" keeps a no-match grep from tripping set -e/pipefail.
deadline_of() {
  grep "^${MARK_BEGIN}" "$HOSTS" 2>/dev/null | head -1 | sed -E 's/.*until=([0-9]+).*/\1/' || true
}

# Format a seconds count as "Xh Ym", clamped to 0 if somehow negative.
fmt_remaining() {
  local secs=$1
  ((secs < 0)) && secs=0
  printf '%dh %dm' $((secs / 3600)) $(((secs % 3600) / 60))
}

require_root() {
  if [[ $EUID -ne 0 ]]; then
    echo "this command needs root: sudo focus $1" >&2
    exit 1
  fi
}

validate_hours() {
  if ! [[ "$1" =~ ^[1-9][0-9]*$ ]]; then
    echo "error: hours must be a whole number greater than 0 (e.g. 1, 2, 24)" >&2
    exit 1
  fi
}

# Write the block with the given deadline epoch and arm a detached timer that
# strips it at that time. Kills any prior timer first so only one is ever live
# (this is what makes double-start and add safe).
arm() {
  local deadline=$1 now
  now=$(date +%s)
  local seconds=$((deadline - now))
  ((seconds < 0)) && seconds=0

  pkill -f "${MARK_BEGIN}" 2>/dev/null || true
  strip_block
  {
    echo "${MARK_BEGIN} until=${deadline}"
    for d in "${DOMAINS[@]}"; do
      echo "127.0.0.1 $d"
      echo "::1 $d"
    done
    echo "$MARK_END"
  } >> "$HOSTS"
  flush_dns

  nohup bash -c "
    sleep ${seconds}
    if [[ \"\$(uname)\" == 'Darwin' ]]; then
      sed -i '' '/^${MARK_BEGIN}/,/^${MARK_END}\$/d' '${HOSTS}'
      dscacheutil -flushcache 2>/dev/null || true
      killall -HUP mDNSResponder 2>/dev/null || true
    else
      sed -i '/^${MARK_BEGIN}/,/^${MARK_END}\$/d' '${HOSTS}'
      systemctl is-active --quiet systemd-resolved 2>/dev/null && resolvectl flush-caches 2>/dev/null || true
      systemctl is-active --quiet nscd 2>/dev/null && nscd -i hosts 2>/dev/null || true
    fi
  " >/dev/null 2>&1 &
  disown
}

cmd_start() {
  local hours="${1:-3}"
  validate_hours "$hours"
  require_root start
  local now deadline
  now=$(date +%s)
  deadline=$(awk "BEGIN{printf \"%d\", $now + $hours*3600}")
  arm "$deadline"
  local ends
  ends=$(fmt_epoch "$deadline")
  echo "Focus on."
  echo "${#DOMAINS[@]} hostnames blocked."
  echo "Ends ${ends} ($(fmt_remaining $((deadline - now))) left)."
  echo "Extend: sudo focus add"
  echo "Stop: sudo focus stop"
}

cmd_add() {
  local hours="${1:-3}"
  validate_hours "$hours"
  require_root add
  local current
  current=$(deadline_of)
  if [[ -z "$current" ]]; then
    echo "no active focus block to extend; start one with: sudo focus start" >&2
    exit 1
  fi
  local now base deadline
  now=$(date +%s)
  # Extend from the current deadline; if it has already lapsed, extend from now.
  base=$((current > now ? current : now))
  deadline=$(awk "BEGIN{printf \"%d\", $base + $hours*3600}")
  arm "$deadline"
  local ends
  ends=$(fmt_epoch "$deadline")
  echo "Added ${hours}h."
  echo "Now ends ${ends} ($(fmt_remaining $((deadline - now))) left)."
}

cmd_stop() {
  require_root stop
  if [[ -z "$(deadline_of)" ]]; then
    echo "Focus already off; nothing to stop."
    return 0
  fi
  pkill -f "${MARK_BEGIN}" 2>/dev/null || true
  strip_block
  flush_dns
  echo "Focus off. Everything unblocked."
}

cmd_status() {
  local deadline
  deadline=$(deadline_of)
  if [[ -z "$deadline" ]]; then
    echo "Off."
    echo "No focus block active."
    return 0
  fi
  local now ends
  now=$(date +%s)
  ends=$(fmt_epoch "$deadline")
  echo "On."
  echo "Ends ${ends} ($(fmt_remaining $((deadline - now))) left)."
  echo "Blocked hostnames:"
  sed -n "/^${MARK_BEGIN}/,/^${MARK_END}\$/p" "$HOSTS" \
    | grep '^127\.0\.0\.1' | awk '{print "  " $2}'
}

case "${1:-}" in
  start)  shift; cmd_start "$@" ;;
  add)    shift; cmd_add "$@" ;;
  stop)   cmd_stop ;;
  status) cmd_status ;;
  *)
    echo "usage: focus {start [hours]|add [hours]|stop|status}" >&2
    echo "  sudo focus start 3   # block for 3 hours (whole number > 0)" >&2
    echo "  sudo focus add 2     # push deadline back 2 more hours (whole number > 0)" >&2
    echo "  sudo focus stop      # stop everything now" >&2
    echo "       focus status    # show state and time left" >&2
    exit 1
    ;;
esac
